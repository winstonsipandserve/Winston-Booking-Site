generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["relationJoins"]
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// ── Enums ──────────────────────────────────────────────

enum ResourceTypeSlug {
  pickleball_court
  tennis_sim
  pickleball_sim
  golf_sim
  lounge
  conference_room
}

enum ResourceCategory {
  court
  simulator
  space
}

enum RateTier {
  member
  non_member
}

enum BookingStatus {
  pending_payment
  confirmed
  cancelled
}

enum ApplicationStatus {
  pending
  approved
  rejected
}

enum MembershipTier {
  player
  premier
  elite
}

enum CreditTransactionReason {
  booking_redemption
  top_up
}

enum PaymentMethod {
  paymongo
  membership_credit
  cash
  manual_online
}

enum AdminRole {
  admin
}

enum AddOnServiceSlug {
  coaching_fee
}

enum PaymentStatus {
  pending
  paid
  failed
}

enum BulletinCategory {
  Renovation
  Closure
  Tournament
  Community
  General
  FacilityMaintenance
  Promotion
}

enum BulletinCustomerEligibility {
  Everyone
  MembersOnly
  NewCustomers
  ReturningCustomers
  SpecificMembershipTier
}

enum ResourceDisabledReason {
  manual
  bulletin
}

enum BulletinBookingImpact {
  NoImpact
  LimitedAvailability
  TemporarilyUnavailable
  ScheduleChanges
}

enum BulletinCustomerAction {
  NoActionRequired
  RescheduleBooking
  ContactSupport
  BookAnotherFacility
  WaitForFurtherNotice
}

enum AnnouncementUrgency {
  info
  warning
  urgent
}

enum NewsCategory {
  tournament
  community
  promo
  general
}

enum NewsStatus {
  draft
  published
}

enum AdminActivityAction {
  membership_application_approved
  membership_application_rejected
  membership_renewal_link_sent
  member_activation_link_resent
  membership_payment_link_resent
  booking_rescheduled
  membership_credit_topup_added
  news_post_created
  news_post_updated
  news_post_deleted
  announcement_created
  announcement_updated
  announcement_deleted
}

enum AdminActivityEntityType {
  membership_application
  booking
  membership
  news_post
  announcement
}

enum AuthRateLimitScope {
  admin_login
  member_login
  admin_password_reset
  member_password_reset
  booking_hold
  membership_application
}

// ── Resource model (Decision: Resource model) ─────────

model ResourceType {
  id                String             @id @default(cuid())
  slug              ResourceTypeSlug   @unique
  name              String
  category          ResourceCategory
  resources         Resource[]
  pricingRules      PricingRule[]
  addOnPricingRules AddOnPricingRule[]
  createdAt         DateTime           @default(now()) @map("created_at")
  updatedAt         DateTime           @updatedAt @map("updated_at")

  @@map("resource_types")
}

model Resource {
  id                String                  @id @default(cuid())
  resourceTypeId    String                  @map("resource_type_id")
  resourceType      ResourceType            @relation(fields: [resourceTypeId], references: [id])
  label             String
  isActive          Boolean                 @default(true) @map("is_active")
  /// Free-text admin note entered on manual disable (e.g. "Under renovation") — renamed
  /// from the original `disabledReason` column (2026-08-27) to make room for the new
  /// structured `disabledReason` enum below. See docs/workflows.md → Announcement-triggered
  /// resource auto-disable.
  disabledNote      String?                 @map("disabled_note")
  /// Which mechanism most recently disabled this resource — null whenever isActive is
  /// true; meaningful only when isActive is false. A manual disable/enable always wins
  /// immediately regardless of any announcement claim (see docs/workflows.md).
  disabledReason    ResourceDisabledReason? @map("disabled_reason")
  bookings          Booking[]
  bulletinLinks     BulletinResource[]
  announcementLinks AnnouncementResource[]
  createdAt         DateTime                @default(now()) @map("created_at")
  updatedAt         DateTime                @updatedAt @map("updated_at")

  @@map("resources")
}

// ── Pricing (Decision: Pricing model) ─────────────────

/// One BASE rate per resource type and duration. Member pricing is not a second set of
/// rows: a member's tier takes a percentage off this base at booking time
/// (MEMBERSHIP_TIER_PLANS[tier].bookingDiscountPercent, see docs/decisions.md).
model PricingRule {
  id              String       @id @default(cuid())
  resourceTypeId  String       @map("resource_type_id")
  resourceType    ResourceType @relation(fields: [resourceTypeId], references: [id])
  durationMinutes Int          @map("duration_minutes")
  priceCentavos   Int          @map("price_centavos")
  createdAt       DateTime     @default(now()) @map("created_at")
  updatedAt       DateTime     @updatedAt @map("updated_at")

  @@unique([resourceTypeId, durationMinutes])
  @@map("pricing_rules")
}

// ── Guest fee (Decision: Guest fee rate storage) ──────

model GuestFeeRule {
  id             String   @id @default(cuid())
  amountCentavos Int      @map("amount_centavos")
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  @@map("guest_fee_rules")
}

// ── Customer & auth (Decision: Customer & auth model) ─

model Customer {
  id                     String                  @id @default(cuid())
  name                   String
  email                  String                  @unique
  phone                  String
  /// Null until a member completes activation via MemberActivationToken. Non-member Customer rows never get one.
  passwordHash           String?                 @map("password_hash")
  /// Stamped by every route that sets passwordHash. A session token issued before this
  /// instant is rejected by getActiveMemberSession, so a reset revokes older sessions.
  passwordChangedAt      DateTime?               @map("password_changed_at")
  /// Null until first generated on /account load (see getOrCreateCheckInToken). Front-desk check-in QR payload.
  checkInToken           String?                 @unique @map("check_in_token")
  /// Zero-padded 6-digit fallback code, always created/rotated together with checkInToken.
  checkInCode            String?                 @unique @map("check_in_code") @db.VarChar(6)
  /// Birthday for the birthday-month court hour (docs/business.md). Copied from the
  /// application when the activation payment is confirmed; null for non-member customers.
  dateOfBirth            DateTime?               @map("date_of_birth") @db.Date
  bookings               Booking[]
  membershipApplications MembershipApplication[]
  memberships            Membership[]
  activationTokens       MemberActivationToken[]
  passwordResetTokens    PasswordResetToken[]
  membershipPayments     MembershipPayment[]
  createdAt              DateTime                @default(now()) @map("created_at")
  updatedAt              DateTime                @updatedAt @map("updated_at")

  @@map("customers")
}

// ── Member activation (Decision: Customer & auth model — post-approval token flow) ─

model MemberActivationToken {
  id         String    @id @default(cuid())
  customerId String    @map("customer_id")
  customer   Customer  @relation(fields: [customerId], references: [id])
  /// SHA-256 hex digest of the raw token — the raw token itself is never stored.
  tokenHash  String    @unique @map("token_hash")
  expiresAt  DateTime  @map("expires_at")
  usedAt     DateTime? @map("used_at")
  createdAt  DateTime  @default(now()) @map("created_at")
  updatedAt  DateTime  @updatedAt @map("updated_at")

  @@map("member_activation_tokens")
}

// ── Password reset (Decision: Password reset token) ───

model PasswordResetToken {
  id         String    @id @default(cuid())
  customerId String    @map("customer_id")
  customer   Customer  @relation(fields: [customerId], references: [id])
  /// SHA-256 hex digest of the raw token — the raw token itself is never stored.
  tokenHash  String    @unique @map("token_hash")
  expiresAt  DateTime  @map("expires_at")
  usedAt     DateTime? @map("used_at")
  createdAt  DateTime  @default(now()) @map("created_at")
  updatedAt  DateTime  @updatedAt @map("updated_at")

  @@map("password_reset_tokens")
}

// ── Admin/staff model (Decision: Admin/staff model) ───

model AdminUser {
  id                       String                    @id @default(cuid())
  name                     String
  email                    String                    @unique
  passwordHash             String                    @map("password_hash")
  /// Same revocation rule as Customer.passwordChangedAt, enforced by getActiveAdminSession.
  passwordChangedAt        DateTime?                 @map("password_changed_at")
  role                     AdminRole                 @default(admin)
  /// Deactivation disables login and every existing session's next request/API call —
  /// enforced via getActiveAdminSession(), not just at sign-in. See CLAUDE.md.
  isActive                 Boolean                   @default(true) @map("is_active")
  reviewedApplications     MembershipApplication[]   @relation("ApplicationReviewedBy")
  performedReschedules     BookingReschedule[]       @relation("ReschedulePerformedBy")
  initiatedRenewalPayments MembershipPayment[]       @relation("MembershipPaymentInitiatedByAdmin")
  initiatedTopUpPayments   Payment[]                 @relation("PaymentInitiatedByAdmin")
  checkInLookupAttempts    CheckInLookupAttempt[]
  passwordResetTokens      AdminPasswordResetToken[]
  activityLogs             AdminActivityLog[]
  createdAnnouncements     Announcement[]
  createdNewsPosts         NewsPost[]
  createdAt                DateTime                  @default(now()) @map("created_at")
  updatedAt                DateTime                  @updatedAt @map("updated_at")

  @@map("admin_users")
}

// ── Admin password reset (Decision: mirrors PasswordResetToken's shape exactly) ─

model AdminPasswordResetToken {
  id          String    @id @default(cuid())
  adminUserId String    @map("admin_user_id")
  adminUser   AdminUser @relation(fields: [adminUserId], references: [id], onDelete: Cascade)
  /// SHA-256 hex digest of the raw token — the raw token itself is never stored.
  tokenHash   String    @unique @map("token_hash")
  expiresAt   DateTime  @map("expires_at")
  usedAt      DateTime? @map("used_at")
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")

  @@map("admin_password_reset_tokens")
}

// ── Booking entry announcements ─────────────────────────

model Announcement {
  id                   String                 @id @default(cuid())
  title                String
  message              String
  urgency              AnnouncementUrgency    @default(info)
  isActive             Boolean                @default(true) @map("is_active")
  /// Optional advance-notice date. The notice is visible on /book from
  /// `announceAt ?? startAt`; resource auto-disable still begins only at `startAt`.
  /// Must be on or before `startAt` when set.
  announceAt           DateTime?              @map("announce_at")
  startAt              DateTime               @default(now()) @map("start_at")
  endAt                DateTime?              @map("end_at")
  /// While enabled, linked resources are taken offline during the active window.
  /// The legacy ResourceDisabledReason value remains `bulletin` until the later
  /// contract migration so old application instances stay compatible during rollout.
  autoDisableResources Boolean                @default(false) @map("auto_disable_resources")
  resourceLinks        AnnouncementResource[]
  /// Nullable only for content migrated from the legacy Bulletin table.
  createdById          String?                @map("created_by_id")
  createdBy            AdminUser?             @relation(fields: [createdById], references: [id], onDelete: SetNull, onUpdate: Cascade)
  createdAt            DateTime               @default(now()) @map("created_at")
  updatedAt            DateTime               @updatedAt @map("updated_at")

  @@index([isActive, startAt, endAt])
  @@index([isActive, announceAt, endAt])
  @@index([createdById])
  @@map("announcements")
}

model AnnouncementResource {
  id             String       @id @default(cuid())
  announcementId String       @map("announcement_id")
  resourceId     String       @map("resource_id")
  announcement   Announcement @relation(fields: [announcementId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  resource       Resource     @relation(fields: [resourceId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  createdAt      DateTime     @default(now()) @map("created_at")

  @@unique([announcementId, resourceId])
  @@index([resourceId])
  @@map("announcement_resources")
}

// ── Public news ──────────────────────────────────────────────

model NewsPost {
  id            String       @id @default(cuid())
  slug          String       @unique
  title         String
  bodyHtml      String       @map("body_html")
  coverImageUrl String?      @map("cover_image_url")
  category      NewsCategory
  publishAt     DateTime?    @map("publish_at")
  status        NewsStatus   @default(draft)
  isFeatured    Boolean      @default(false) @map("is_featured")
  /// Nullable only for content migrated from the legacy Bulletin table.
  createdById   String?      @map("created_by_id")
  createdBy     AdminUser?   @relation(fields: [createdById], references: [id], onDelete: SetNull, onUpdate: Cascade)
  createdAt     DateTime     @default(now()) @map("created_at")
  updatedAt     DateTime     @updatedAt @map("updated_at")

  @@index([status, publishAt])
  @@index([isFeatured, publishAt])
  @@index([category, publishAt])
  @@index([createdById])
  @@map("news_posts")
}

// ── Check-in code rate limiting (Decision: Member check-in) ──
// Soft abuse-detection counter for /admin/check-in's Enter Code lookup — not a
// financial/audit ledger, so no locking/transaction guarantee is required (see CLAUDE.md).

model CheckInLookupAttempt {
  id          String    @id @default(cuid())
  adminUserId String    @map("admin_user_id")
  adminUser   AdminUser @relation(fields: [adminUserId], references: [id], onDelete: Cascade)
  createdAt   DateTime  @default(now()) @map("created_at")
  // No updatedAt — write-once rows, cleared by opportunistic delete once outside the window.

  @@index([adminUserId, createdAt])
  @@map("check_in_lookup_attempts")
}

// ── Membership application & approval ─────────────────

model MembershipApplication {
  id                String                       @id @default(cuid())
  customerId        String                       @map("customer_id")
  customer          Customer                     @relation(fields: [customerId], references: [id])
  requestedTier     MembershipTier               @map("requested_tier")
  status            ApplicationStatus            @default(pending)
  /// Submitted with the application; copied to Customer.dateOfBirth on activation.
  dateOfBirth       DateTime                     @map("date_of_birth") @db.Date
  address           String
  contactNumber     String                       @map("contact_number")
  govIdFrontUrl     String                       @map("gov_id_front_url")
  govIdBackUrl      String                       @map("gov_id_back_url")
  govIdSelfieUrl    String                       @map("gov_id_selfie_url")
  rejectionReason   String?                      @map("rejection_reason")
  reviewedById      String?                      @map("reviewed_by_id")
  reviewedBy        AdminUser?                   @relation("ApplicationReviewedBy", fields: [reviewedById], references: [id])
  reviewedAt        DateTime?                    @map("reviewed_at")
  membership        Membership?
  payments          MembershipPayment[]
  paymentLinkTokens MembershipPaymentLinkToken[]
  createdAt         DateTime                     @default(now()) @map("created_at")
  updatedAt         DateTime                     @updatedAt @map("updated_at")

  @@map("membership_applications")
}

// ── Membership payment link (Decision: mirrors MemberActivationToken's shape) ─
// Gates /membership/pay/[id] + POST /api/membership-payments (applicationId) and
// /membership/renew/[id] + POST /api/membership-payments/[id]/checkout (membershipPaymentId)
// with a bounded-lifetime, hashed capability token instead of a bare id — see CLAUDE.md.
// Nullable, mutually-exclusive FKs rather than two token tables — same choice already made
// for Payment.bookingId/membershipId, for the same reason (real FK integrity per link kind).

model MembershipPaymentLinkToken {
  id                  String                 @id @default(cuid())
  applicationId       String?                @map("application_id")
  application         MembershipApplication? @relation(fields: [applicationId], references: [id])
  membershipPaymentId String?                @map("membership_payment_id")
  membershipPayment   MembershipPayment?     @relation(fields: [membershipPaymentId], references: [id])
  /// SHA-256 hex digest of the raw token — the raw token itself is never stored.
  tokenHash           String                 @unique @map("token_hash")
  expiresAt           DateTime               @map("expires_at")
  /// Set when superseded by a newer resend, same technique as MemberActivationToken —
  /// this token is never "consumed" by a single successful action since a customer may
  /// make several checkout attempts before paying.
  usedAt              DateTime?              @map("used_at")
  createdAt           DateTime               @default(now()) @map("created_at")
  updatedAt           DateTime               @updatedAt @map("updated_at")

  @@index([applicationId])
  @@index([membershipPaymentId])
  @@map("membership_payment_link_tokens")
}

// ── Membership payment (Decision: Membership payment ↔ Payment relationship) ─
// Dedicated model, not a link off the booking-scoped Payment table — see CLAUDE.md.
// No unique constraint on applicationId: multiple rows can exist per application over
// time (one per checkout attempt); tier/amountCentavos are a priced snapshot at creation,
// independent of future MEMBERSHIP_TIER_PLANS edits — same pattern as BookingAddOn.

model MembershipPayment {
  id                        String                       @id @default(cuid())
  applicationId             String?                      @map("application_id")
  application               MembershipApplication?       @relation(fields: [applicationId], references: [id])
  customerId                String                       @map("customer_id")
  customer                  Customer                     @relation(fields: [customerId], references: [id])
  tier                      MembershipTier
  amountCentavos            Int                          @map("amount_centavos")
  /// Priced as a Founding Member (Premier at the Founding price). Decided when the row is
  /// priced (src/lib/membership-founding.ts) and copied onto the Membership on payment.
  isFounding                Boolean                      @default(false) @map("is_founding")
  status                    PaymentStatus                @default(pending)
  paymongoCheckoutSessionId String?                      @unique @map("paymongo_checkout_session_id")
  paymongoPaymentIntentId   String?                      @unique @map("paymongo_payment_intent_id")
  paidAt                    DateTime?                    @map("paid_at")
  /// Set only when an admin sends a manual renewal-payment-link (see CLAUDE.md → Membership
  /// payment model). Null for self-service renewal and the original application-flow payment.
  initiatedByAdminId        String?                      @map("initiated_by_admin_id")
  initiatedByAdmin          AdminUser?                   @relation("MembershipPaymentInitiatedByAdmin", fields: [initiatedByAdminId], references: [id])
  paymentLinkTokens         MembershipPaymentLinkToken[]
  createdAt                 DateTime                     @default(now()) @map("created_at")
  updatedAt                 DateTime                     @updatedAt @map("updated_at")

  @@index([applicationId])
  @@index([customerId])
  @@index([initiatedByAdminId])
  @@map("membership_payments")
}

// ── Membership & credit ledger (Decision: Membership credit ledger) ─

model Membership {
  id                    String                        @id @default(cuid())
  customerId            String                        @map("customer_id")
  customer              Customer                      @relation(fields: [customerId], references: [id])
  applicationId         String?                       @unique @map("application_id")
  application           MembershipApplication?        @relation(fields: [applicationId], references: [id])
  tier                  MembershipTier
  /// Founding Member: one of the first 100 paid Premier activations, or a renewal by such a
  /// customer. Permanent for that customer; a flag rather than a tier (docs/decisions.md).
  isFounding            Boolean                       @default(false) @map("is_founding")
  /// `endDate` alone decides whether a term is live (see docs/database.md).
  startDate             DateTime                      @map("start_date")
  endDate               DateTime                      @map("end_date")
  /// Cached running total — MembershipCreditTransaction is the source of truth. Starts at
  /// zero: no credit is granted with a membership; only top-ups add to it.
  creditBalanceCentavos Int                           @default(0) @map("credit_balance_centavos")
  creditTransactions    MembershipCreditTransaction[]
  /// Top-up Payments only (membershipId set) — activation/renewal payments stay on MembershipPayment.
  payments              Payment[]
  /// Reminder/expiry-email tracking — each nullable timestamp is set once its email fires,
  /// so the membership-reminders cron can never send the same email twice to a row.
  reminder14SentAt      DateTime?                     @map("reminder_14_sent_at")
  reminder3SentAt       DateTime?                     @map("reminder_3_sent_at")
  expiredNoticeSentAt   DateTime?                     @map("expired_notice_sent_at")
  createdAt             DateTime                      @default(now()) @map("created_at")
  updatedAt             DateTime                      @updatedAt @map("updated_at")

  @@map("memberships")
}

model MembershipCreditTransaction {
  id             String                  @id @default(cuid())
  membershipId   String                  @map("membership_id")
  membership     Membership              @relation(fields: [membershipId], references: [id])
  /// Set only for booking_redemption rows — which booking this debit paid for.
  /// Null for top_up credits, which have no associated booking.
  bookingId      String?                 @map("booking_id")
  booking        Booking?                @relation(fields: [bookingId], references: [id])
  /// Positive for credits added (top_up), negative for debits (booking_redemption) —
  /// SUM(amountCentavos) per membership always recovers the correct balance regardless
  /// of reason.
  amountCentavos Int                     @map("amount_centavos")
  reason         CreditTransactionReason
  createdAt      DateTime                @default(now()) @map("created_at")
  // No updatedAt — immutable audit row, corrections are new rows, never edits.

  @@index([bookingId])
  @@map("membership_credit_transactions")
}

// ── Booking & exclusion constraint (raw SQL — see Part 5) ─

model Booking {
  id                     String                        @id @default(cuid())
  customerId             String?                       @map("customer_id")
  customer               Customer?                     @relation(fields: [customerId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  resourceId             String                        @map("resource_id")
  resource               Resource                      @relation(fields: [resourceId], references: [id])
  startTime              DateTime                      @map("start_time")
  endTime                DateTime                      @map("end_time")
  status                 BookingStatus                 @default(pending_payment)
  guestCount             Int                           @default(0) @map("guest_count")
  /// Discounted court/sim rate + guest fee only — excludes add-ons, which are priced separately on BookingAddOn.
  totalAmountCentavos    Int                           @map("total_amount_centavos")
  /// Snapshot of the tier discount already taken off the base rate inside totalAmountCentavos
  /// (0 for non-member bookings), so receipts can show "Member discount −₱x" independent of
  /// later rate or tier changes.
  memberDiscountCentavos Int                           @default(0) @map("member_discount_centavos")
  /// Snapshot of the guest fee actually charged at booking time, already included inside
  /// totalAmountCentavos above — this column exists only so the guest fee can be broken back
  /// out for display (e.g. the confirmation receipt), independent of any later GuestFeeRule edit.
  guestFeeAmountCentavos Int                           @default(0) @map("guest_fee_amount_centavos")
  /// Guests whose fee was waived by complimentary guest passes on this booking. Passes used
  /// in a term are derived by summing this over the member's slot-occupying bookings inside
  /// the term (src/lib/member-perks.ts) — there is no separate counter.
  guestPassesUsed        Int                           @default(0) @map("guest_passes_used")
  /// The birthday-month court hour was redeemed on this booking: memberDiscountCentavos then
  /// holds the birthday reduction (50% or 100% of the base rate) instead of the tier discount.
  birthdayPerkApplied    Boolean                       @default(false) @map("birthday_perk_applied")
  /// Snapshot of the name/phone actually submitted for this specific booking at
  /// customer-attach time, independent of any later change to the linked Customer row.
  customerNameSnapshot   String?                       @map("customer_name_snapshot")
  customerPhoneSnapshot  String?                       @map("customer_phone_snapshot")
  /// Hash of the short-lived, HttpOnly browser capability used only by an anonymous
  /// booker to complete and confirm their own booking. Never store the raw token.
  accessTokenHash        String?                       @map("access_token_hash")
  accessTokenExpiresAt   DateTime?                     @map("access_token_expires_at")
  /// HMAC of the client that created this hold (member id, or the request IP for anonymous
  /// bookers). Used only to cap live holds per client in src/lib/booking-hold-abuse.ts.
  /// Never the raw IP. Null on admin/manual rows and rows created before the cap existed.
  holdClientHash         String?                       @map("hold_client_hash")
  reschedules            BookingReschedule[]
  addOns                 BookingAddOn[]
  payment                Payment?
  creditTransactions     MembershipCreditTransaction[]
  createdAt              DateTime                      @default(now()) @map("created_at")
  updatedAt              DateTime                      @updatedAt @map("updated_at")

  @@index([holdClientHash, status, createdAt])
  @@map("bookings")
}

// â”€â”€ Authentication abuse controls â”€â”€
// A short-lived, write-once rate-limit counter for credential and reset-email abuse.
// identifierHash is an HMAC of an email address or client IP, so raw identifiers never
// enter this table. Retention is expire-on-write in src/lib/auth-rate-limit.ts.

model AuthRateLimitAttempt {
  id             String             @id @default(cuid())
  scope          AuthRateLimitScope
  identifierHash String             @map("identifier_hash")
  createdAt      DateTime           @default(now()) @map("created_at")
  // No updatedAt â€” attempts are immutable and deleted once outside their rate window.

  @@index([scope, identifierHash, createdAt])
  @@index([createdAt])
  @@map("auth_rate_limit_attempts")
}

// ── Reschedule audit trail (Decision: BookingReschedule immutability) ─

model BookingReschedule {
  id            String    @id @default(cuid())
  bookingId     String    @map("booking_id")
  booking       Booking   @relation(fields: [bookingId], references: [id])
  originalStart DateTime  @map("original_start")
  originalEnd   DateTime  @map("original_end")
  newStart      DateTime  @map("new_start")
  newEnd        DateTime  @map("new_end")
  reason        String
  performedById String    @map("performed_by_id")
  performedBy   AdminUser @relation("ReschedulePerformedBy", fields: [performedById], references: [id])
  createdAt     DateTime  @default(now()) @map("created_at")
  // No updatedAt — corrections are new rows, never edits to the original.

  @@map("booking_reschedules")
}

// ── Add-on services ────────────────────────────────────

model AddOnService {
  id            String             @id @default(cuid())
  slug          AddOnServiceSlug   @unique
  name          String
  pricingRules  AddOnPricingRule[]
  bookingAddOns BookingAddOn[]
  createdAt     DateTime           @default(now()) @map("created_at")
  updatedAt     DateTime           @updatedAt @map("updated_at")

  @@map("add_on_services")
}

model AddOnPricingRule {
  id             String         @id @default(cuid())
  addOnServiceId String         @map("add_on_service_id")
  addOnService   AddOnService   @relation(fields: [addOnServiceId], references: [id])
  resourceTypeId String         @map("resource_type_id")
  resourceType   ResourceType   @relation(fields: [resourceTypeId], references: [id])
  rateTier       RateTier       @map("rate_tier")
  /// Null for simulator coaching (single flat rate). 1 or 2 for court coaching.
  paxCount       Int?           @map("pax_count")
  priceCentavos  Int            @map("price_centavos")
  bookingAddOns  BookingAddOn[]
  createdAt      DateTime       @default(now()) @map("created_at")
  updatedAt      DateTime       @updatedAt @map("updated_at")

  @@unique([addOnServiceId, resourceTypeId, rateTier, paxCount])
  @@map("add_on_pricing_rules")
}

model BookingAddOn {
  id                 String           @id @default(cuid())
  bookingId          String           @map("booking_id")
  booking            Booking          @relation(fields: [bookingId], references: [id])
  addOnServiceId     String           @map("add_on_service_id")
  addOnService       AddOnService     @relation(fields: [addOnServiceId], references: [id])
  addOnPricingRuleId String           @map("add_on_pricing_rule_id")
  addOnPricingRule   AddOnPricingRule @relation(fields: [addOnPricingRuleId], references: [id])
  quantity           Int              @default(1)
  /// Snapshot of the price actually charged, independent of future AddOnPricingRule edits.
  amountCentavos     Int              @map("amount_centavos")
  createdAt          DateTime         @default(now()) @map("created_at")
  updatedAt          DateTime         @updatedAt @map("updated_at")

  @@map("booking_add_ons")
}

// ── Payment (Decision: Payment ↔ Booking relationship) ─

model Payment {
  id                        String        @id @default(cuid())
  /// Nullable + unique: one Payment per Booking today; null bookingId reserved for future POS transactions.
  bookingId                 String?       @unique @map("booking_id")
  booking                   Booking?      @relation(fields: [bookingId], references: [id])
  /// Nullable, NOT unique (unlike bookingId) — a Membership can have many top-up
  /// Payments over its lifetime. Set only for membership-credit-top-up rows;
  /// null for booking payments. See CLAUDE.md → Membership credit ledger.
  membershipId              String?       @map("membership_id")
  membership                Membership?   @relation(fields: [membershipId], references: [id])
  amountCentavos            Int           @map("amount_centavos")
  status                    PaymentStatus @default(pending)
  method                    PaymentMethod @default(paymongo)
  paymongoCheckoutSessionId String?       @unique @map("paymongo_checkout_session_id")
  paymongoPaymentIntentId   String?       @unique @map("paymongo_payment_intent_id")
  /// PayMongo's own payment-resource id (pay_xxx) — distinct from paymongoPaymentIntentId (pi_xxx). Captured from the payment.paid webhook; existing rows stay null, not backfilled.
  paymongoPaymentId         String?       @unique @map("paymongo_payment_id")
  /// PayMongo's fee + foreign_fee combined, captured from the payment.paid
  /// webhook. Null for credit-covered bookings (no PayMongo transaction)
  /// and for bookings confirmed before this column existed — not backfilled.
  paymongoFeeCentavos       Int?          @map("paymongo_fee_centavos")
  /// PayMongo's net_amount (what actually settles to the merchant account),
  /// captured from the same webhook. Same null cases as the fee column above.
  paymongoNetAmountCentavos Int?          @map("paymongo_net_amount_centavos")
  /// Admin-entered reference for manual_online top-ups (GCash ref, bank transfer ref, etc).
  externalReference         String?       @map("external_reference")
  /// Required (enforced at the API layer, not the DB) for cash top-ups; optional for manual_online.
  adminNote                 String?       @map("admin_note")
  /// Set only on admin-logged top-ups (cash/manual_online) — mirrors MembershipPayment.initiatedByAdminId.
  initiatedByAdminId        String?       @map("initiated_by_admin_id")
  initiatedByAdmin          AdminUser?    @relation("PaymentInitiatedByAdmin", fields: [initiatedByAdminId], references: [id])
  paidAt                    DateTime?     @map("paid_at")
  createdAt                 DateTime      @default(now()) @map("created_at")
  updatedAt                 DateTime      @updatedAt @map("updated_at")

  @@index([membershipId])
  @@index([initiatedByAdminId])
  @@map("payments")
}

// ── Bulletin ────────────────────────────────────────────

model Bulletin {
  id                   String                       @id @default(cuid())
  title                String
  excerpt              String
  body                 String
  category             BulletinCategory
  imageUrl             String?                      @map("image_url")
  socialPlatform       String?                      @map("social_platform")
  socialUrl            String?                      @map("social_url")
  affectedFacility     String?                      @map("affected_facility")
  impact               String?
  action               String?
  bookingImpact        BulletinBookingImpact?       @map("booking_impact")
  customerActionType   BulletinCustomerAction?      @map("customer_action_type")
  /// Display-only Promotion-category fields — never validated/redeemed against a real
  /// price; the discount itself is applied manually by an admin via PricingRule. See
  /// CLAUDE.md's Bulletin / Promotion category decision.
  promoCode            String?                      @map("promo_code")
  discountSummary      String?                      @map("discount_summary")
  customerEligibility  BulletinCustomerEligibility? @map("customer_eligibility")
  eventStartAt         DateTime?                    @map("event_start_at")
  eventEndAt           DateTime?                    @map("event_end_at")
  expiresAt            DateTime?                    @map("expires_at")
  ctaLabel             String?                      @map("cta_label")
  ctaUrl               String?                      @map("cta_url")
  isPublished          Boolean                      @default(false) @map("is_published")
  publishedAt          DateTime?                    @map("published_at")
  /// Admin toggle: while true and this bulletin is published (and not expired), its
  /// linked resources (via BulletinResource) are auto-disabled. See CLAUDE.md.
  autoDisableResources Boolean                      @default(false) @map("auto_disable_resources")
  resourceLinks        BulletinResource[]
  createdAt            DateTime                     @default(now()) @map("created_at")
  updatedAt            DateTime                     @updatedAt @map("updated_at")

  @@map("bulletins")
}

// ── Bulletin-triggered resource auto-disable (Decision: Bulletin-triggered resource auto-disable) ─

model BulletinResource {
  id         String   @id @default(cuid())
  bulletinId String   @map("bulletin_id")
  resourceId String   @map("resource_id")
  bulletin   Bulletin @relation(fields: [bulletinId], references: [id], onDelete: Cascade)
  resource   Resource @relation(fields: [resourceId], references: [id], onDelete: Cascade)
  createdAt  DateTime @default(now()) @map("created_at")
  // No updatedAt — a link either exists or doesn't; edits replace the row set, never mutate a row.

  @@unique([bulletinId, resourceId])
  @@map("bulletin_resources")
}

// ── Admin activity log (Decision: audit trail for admin-initiated actions) ─
// Immutable audit row, same shape as BookingReschedule/MembershipCreditTransaction —
// no updatedAt, corrections are new rows, never edits to the original.

model AdminActivityLog {
  id          String                  @id @default(cuid())
  adminId     String                  @map("admin_id")
  admin       AdminUser               @relation(fields: [adminId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  action      AdminActivityAction
  entityType  AdminActivityEntityType @map("entity_type")
  /// Loose reference, deliberately not a real FK — this one table logs against
  /// multiple entity types (membership_application, booking).
  entityId    String                  @map("entity_id")
  description String
  metadata    Json?
  createdAt   DateTime                @default(now()) @map("created_at")
  // No updatedAt — immutable audit row, corrections are new rows, never edits.

  @@index([adminId])
  @@index([createdAt])
  @@map("admin_activity_logs")
}
